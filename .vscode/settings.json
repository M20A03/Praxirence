{
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/venv": true,
    "**/.pytest_cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/android/build/**": true,
    "**/android/.gradle/**": true,
    "**/android/app/build/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.venv/**": true,
    "**/venv/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/android/build": true,
    "**/android/.gradle": true,
    "**/dist": true,
    "**/build": true,
    "**/.venv": true,
    "**/venv": true
  },
  "C_Cpp.errorSquiggles": "disabled",
  "gradle.autoDetect": "off",
  "gradle.nestedProjects": false,
  "gradle.server.enabled": false,
  "typescript.disableAutomaticTypeAcquisition": true
}

