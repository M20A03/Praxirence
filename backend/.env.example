# ==============================================================================
# PRAXIRENCE HEALTHCARE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=praxirence-super-secret-jwt-key-change-in-production-32bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
# Local Docker compose uses: postgresql://postgres:postgres@db:5432/praxirence
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/praxirence

# Data Encryption at Rest (AES-256 Fernet Key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=rV8_NqjH6_t5z9oEwM11x2_4pX-9yK0Z7Q_3uI6v8w0=
PHONE_HASH_SALT=praxirence-phone-blind-index-salt-v1

# Redis (Caching, Queues, Background Workers)
REDIS_URL=redis://localhost:6379/0

# OpenAI API (Whisper Voice Transcription & GPT-4 Clinical Entity Extraction)
# If left blank, the application automatically uses simulated clinical Whisper & GPT-4 models.
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_GPT_MODEL=gpt-4o

# Twilio (WhatsApp Delivery & Patient OTP Verification)
# If left blank, WhatsApp messages are logged to console and mock OTP '123456' is accepted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VERIFY_SERVICE_SID=

# Firebase Cloud Messaging (Patient Mobile App Push Notifications)
# Path to service-account.json file if available
FIREBASE_CREDENTIALS_PATH=

# Audio Temporary Storage Directory
AUDIO_UPLOAD_DIR=/tmp/praxirence_recordings
